# Notion API integration
# Copy this file to .env and fill in the values.
# Get the API key from: https://developers.notion.com/
# Share the databases with the integration you create.
NOTION_API_KEY=

# Notion database IDs (the 32-char ID from the database URL)
MEMBERS_DB_ID=
NOTION_DB_BILLS_ID=
NOTION_CONTRIBUTIONS_DB_ID=

# Frontend origin allowed by CORS (optional, defaults to the Vercel domain)
FRONTEND_URL=
